datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TicketCategory {
  ACCOUNT
  ORDER
  REFUND
  CONTACT
  PAYMENT
  FEEDBACK
  SHIPPING
  INVOICE
  DELIVERY
  SUBSCRIPTION
  CANCEL
  UNCLASSIFIED
}

enum TicketUrgency {
  Low
  Medium
  High
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum TicketActivityType {
  TICKET_CREATED
  ASSIGNEE_CHANGED
  STATUS_CHANGED
  INTERNAL_NOTE_ADDED
  CATEGORY_CORRECTED
}

enum UserRole {
  ADMIN
  AGENT
}

model Workspace {
  id         String           @id @default(uuid())
  name       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tickets    Ticket[]
  agents     Agent[]
  users      User[]
  notes      TicketNote[]
  activities TicketActivity[]
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  displayName  String
  passwordHash String
  role         UserRole         @default(AGENT)
  isActive     Boolean          @default(true)
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agent        Agent?
  activities   TicketActivity[]
  notes        TicketNote[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([workspaceId, role])
}

model Ticket {
  id                String           @id @default(uuid())
  title             String
  description       String
  category          TicketCategory   @default(UNCLASSIFIED)
  urgency           TicketUrgency    @default(Medium)
  isFallback        Boolean          @default(false)
  status            TicketStatus     @default(NEW)
  assigneeId        String?
  assignee          Agent?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  workspaceId       String
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  predictedCategory TicketCategory?
  dueAt             DateTime?
  resolvedAt        DateTime?
  notes             TicketNote[]
  activities        TicketActivity[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, urgency, createdAt])
  @@index([assigneeId, status])
  @@index([workspaceId, status, urgency, createdAt])
}

model Agent {
  id          String    @id @default(uuid())
  displayName String
  email       String    @unique
  isActive    Boolean   @default(true)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, isActive])
}

model TicketNote {
  id           String    @id @default(uuid())
  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content      String
  authorName   String    @default("System")
  authorUserId String?
  author       User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([ticketId, createdAt])
  @@index([workspaceId, createdAt])
}

model TicketActivity {
  id          String             @id @default(uuid())
  sequence    Int                @unique @default(autoincrement())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        TicketActivityType
  actorName   String             @default("System")
  actorUserId String?
  actor       User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata    Json?
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())

  @@index([ticketId, createdAt])
  @@index([ticketId, sequence])
  @@index([workspaceId, createdAt])
}
