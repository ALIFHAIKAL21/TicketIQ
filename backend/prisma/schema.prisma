datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TicketCategory {
  ACCOUNT
  ORDER
  REFUND
  CONTACT
  PAYMENT
  FEEDBACK
  SHIPPING
  INVOICE
  DELIVERY
  SUBSCRIPTION
  CANCEL
  UNCLASSIFIED
}

enum TicketUrgency {
  Low
  Medium
  High
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  category    TicketCategory @default(UNCLASSIFIED)
  urgency     TicketUrgency  @default(Medium)
  isFallback  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
