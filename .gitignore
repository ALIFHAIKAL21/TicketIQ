# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Local Python environments
.venv/
venv/
env/
ENV/

# Local environment variables and secrets
.env
.env.*
!.env.example

# Python test, type-checker, and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Hugging Face and local tool caches
.cache/
huggingface_cache/

# Generated dataset CSVs (re-create with ml-service/prepare_dataset.py)
/ml-service/data/*.csv

# Trained model artifacts; store separately or recreate by training
/ml-service/models/

# Final test results are regenerated once in a fresh checkout
/ml-service/reports/test_scores.csv
/ml-service/reports/distilbert_test_confusion_matrix.csv